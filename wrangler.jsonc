{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animax-previewer",
  "main": "worker/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-29",
  // UTC 00:00–15:59 on the 1st = Shanghai 08:00–23:59 on reset day.
  "triggers": { "crons": ["* 0-15 1 * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "animax-previewer",
    "database_id": "15b475ca-779b-4d96-a3f4-53615fa93707"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "animax-previewer" }]
}
